{
  "name": "traceline",
  "version": "0.1.0",
  "private": true,
  "description": "Living, audit-ready traceability for safety-critical software in Jira and Confluence (Atlassian Forge).",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.ui.json",
    "lint:manifest": "forge lint",
    "build:ui": "vite build static/cockpit && vite build static/matrix",
    "predeploy": "npm run typecheck && npm test && npm run build:ui"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.32",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "fast-check": "^4.11.0",
    "react-dom": "^18.3.1",
    "typescript": "5.9",
    "vite": "^6.4.6",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@forge/api": "^8.5.1",
    "@forge/bridge": "^7.4.0",
    "@forge/events": "^3.0.11",
    "@forge/kvs": "^2.1.3",
    "@forge/react": "^12.6.0",
    "@forge/resolver": "^2.0.2",
    "@forge/sql": "^4.0.11",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1"
  }
}